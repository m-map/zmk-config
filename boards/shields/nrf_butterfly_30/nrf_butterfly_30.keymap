// GENERATED FILE -- edit layout.txt and run generate-keymap.py instead.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        // Tap = base key, hold = momentary-activate a layer. "tap-preferred"
        // flavor: an interrupting key press only resolves to the layer if
        // the hold-tap key is still held past the tapping term; fast rolls
        // (e.g. "to", "ti") resolve as taps instead of misfiring into the
        // layer. Drives every "<base>L<n>" combo token.
        hold_layer: hold_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
            display-name = "Hold Layer";
        };

        // Tap = base key, hold = toggle a layer on/off. Same tap-preferred
        // timing as hold_layer. Drives every "<base>T<n>" combo token.
        hold_toggle: hold_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&tog>, <&kp>;
            display-name = "Hold Toggle Layer";
        };

        // Tap = base key, hold = a different key (used for modifiers, e.g.
        // Z taps 'z' but held acts as left shift). Drives every "<base>K<n>"
        // combo token, where K<n> is defined by a "K<n> = <token>" alias
        // line in layout.txt.
        //
        // "balanced" + hold-trigger-on-release: if another key is pressed
        // AND released while this key is still held, that resolves to hold
        // as soon as the other key releases -- no waiting out the tapping
        // term -- so holding B and tapping C for Cmd+C feels like a real
        // chord instead of a laggy timeout. require-prior-idle-ms keeps
        // ordinary fast typing safe: if this key is pressed within 150ms of
        // any other keypress, it resolves as a tap immediately, no hold
        // ever considered. retro-tap is deliberately NOT set: holding a
        // modifier alone and releasing it with nothing else pressed must
        // keep producing no output, same as holding a real shift key.
        hold_mod: hold_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
            display-name = "Hold Mod";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &tog 1
&kp A &kp S &hold_layer 5 D &hold_layer 2 F &kp G &kp H &kp J &kp K &kp L &hold_layer 3 SEMI
&hold_mod LSHFT Z &hold_mod LCTRL X &kp C &hold_mod LALT V &hold_mod LGUI B &kp SPACE &kp N &kp M &kp COMMA &hold_mod RSHFT DOT
            >;
        };

        T1 {
            bindings = <
&kp TAB &kp N1 &kp N2 &kp N3 &kp N4 &trans &trans &kp UP &trans &trans
&kp A &kp Q &kp W &kp E &kp R &trans &kp LEFT &kp DOWN &kp RIGHT &trans
&kp LCTRL &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        L1 {
            bindings = <
&kp ESC &kp GRAVE &trans &trans &trans &trans &trans &kp MINUS &kp EQUAL &kp BSPC
&kp TAB &trans &trans &trans &trans &trans &kp LBKT &kp RBKT &kp BSLH &kp ENTER
&trans &trans &trans &trans &trans &trans &trans &kp LS(SEMI) &kp SQT &kp FSLH
            >;
        };

        L2 {
            bindings = <
&kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
&trans &trans &trans &trans &trans &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans
&trans &trans &trans &trans &trans &trans &out OUT_USB &out OUT_BLE &mo 4 &kp LSHFT
            >;
        };

        L3 {
            bindings = <
&kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        L4 {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &kp UP &trans &trans
&trans &trans &trans &trans &trans &trans &kp LEFT &kp DOWN &kp RIGHT &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
