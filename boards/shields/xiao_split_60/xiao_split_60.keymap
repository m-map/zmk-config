&kp LALT &kp LGUI &mo 1 &tog 2 &kp C_VOL_DN &kp GRAVE &kp C_MUTE &kp C_VOL_UP &kp ENTER &kp ENTER &kp SPACE &mo 3
            >;
        };

        sys {
            bindings = <
&out OUT_BLE &out OUT_USB &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_CLR &trans &trans &trans &kp MINUS &kp EQUAL &trans
&trans &trans &trans &trans &trans &trans &trans &trans &kp UP &kp LBKT &kp RBKT &kp BSLH
&trans &trans &trans &trans &trans &trans &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &kp C_BRI_DN &trans &trans &kp C_BRI_UP &trans &trans &trans &trans
            >;
